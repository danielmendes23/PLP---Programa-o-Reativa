{
  "name": "monitor-agente-experimento",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Experimento acadêmico controlado de agentes de IA com e sem harness",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "demo": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests/unit",
    "arch": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "validate": "npm run typecheck && npm run lint && npm run arch && npm run test"
  },
  "dependencies": {
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.1",
    "@eslint/js": "^9.39.1"
  }
}
