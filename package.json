{
  "name": "reactive-ai-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Experimento acadêmico controlado de agentes de IA com e sem harness",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "demo": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/unit evaluation/acceptance",
    "arch": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "test": "vitest run tests/unit",
    "test:acceptance": "vitest run evaluation/acceptance",
    "offline": "node --experimental-strip-types --test tests/offline/*.test.mjs && node scripts/check-architecture.mjs src && node scripts/check-experiment.mjs",
    "validate": "npm run typecheck && npm run lint && npm run arch && npm run test && npm run test:acceptance && npm run offline",
    "experiment:prepare": "node scripts/prepare-experiment.mjs",
    "experiment:evaluate": "node scripts/evaluate-experiment.mjs",
    "experiment:compare": "node scripts/compare-results.mjs",
    "experiment:record": "node scripts/record-intervention.mjs",
    "experiment:session": "node scripts/record-session.mjs"
  },
  "dependencies": {
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.1",
    "@eslint/js": "^9.39.1"
  }
}
